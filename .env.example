# Copy this file to .env and fill in the values. Never commit .env.
# Backend variables (read by Spring Boot from the environment).

# --- Required
# Secret used to sign the JWTs, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Database (default: local MongoDB)
MONGODB_URI=mongodb://localhost:27017/voixdesagesse

# --- Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (defaults target Mailpit, a local mail catcher on port 1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@voixdesagesse.local

# --- Optional
# PORT=8080
# JWT_EXPIRATION_MS=86400000
# UPLOAD_DIR=uploads/profile-pictures
