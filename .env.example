# Copy this file to .env, then add the JWT secret (never commit .env):
#   cp .env.example .env
#   echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
#   docker compose up --build

# --- Demo data, created on the first start (empty database)
DEMO_DATA=true
# Password of demo@voixdesagesse.local and of the demo authors (karim@, amina@, youssef@)
DEMO_USER_PASSWORD=Demo1234!
# Password of admin@voixdesagesse.local; leave empty to create no admin account
DEMO_ADMIN_PASSWORD=Admin1234!

# --- Backend variables, set by docker-compose.yml; needed when running the backend another way
# JWT_SECRET=                 required, at least 32 bytes
# MONGODB_URI=mongodb://localhost:27017/voixdesagesse
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=no-reply@voixdesagesse.local
# PORT=8080
# JWT_EXPIRATION_MS=86400000
# UPLOAD_DIR=uploads/profile-pictures
